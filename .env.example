# ==============================================================================
# AURELLE LUXURY COUTURE — ENVIRONMENT CONFIGURATION TEMPLATE
# NEVER commit real production secrets, private keys, or passwords to source control.
# Copy this file to `.env.local` for local development.
# ==============================================================================

# Node Environment
NODE_ENV=development

# Storefront Public Config (Public to browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME="AURELLE"

# Administrative Vault Protection (Server-side ONLY — NEVER expose to browser)
# Generate high-entropy 32+ character secrets in production:
# e.g.: openssl rand -base64 32
ADMIN_SECRET_KEY=generate-a-strong-32-char-admin-secret-key-here
ADMIN_SESSION_SECRET=generate-a-strong-32-char-hmac-session-secret-here

# Supabase Production Database (Server-side & Client RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-server-only

# Razorpay Payments (Configured in Phase 11 — Server-side ONLY)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=your-razorpay-secret-key
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Transactional Communication (Resend / Courier)
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=orders@aurelle.in
